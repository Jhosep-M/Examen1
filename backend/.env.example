# Copia este archivo como .env y completa con tus credenciales reales
# .env NO se sube a git (ver .gitignore)

# Host de SQL Server
# Ejemplos:
# - LocalDB (Windows): (localdb)\MSSQLLocalDB
# - SQLEXPRESS local: localhost
# - Servidor remoto: 192.168.1.10  o  nombre_instancia\SQLEXPRESS
DB_HOST=localhost

# Usuario SQL (vacío si usas Trusted_Connection / Windows Auth)
DB_USER=usuario_sql

# Contraseña SQL (vacía si usas Trusted_Connection)
DB_PASSWORD=tu_contraseña

# Nombre de la base de datos
DB_NAME=WEB2DB

# Puerto (1433 por defecto para SQL Server)
DB_PORT=1433

# Instancia opcional (ej: SQLEXPRESS) - descomenta si tu host usa instancia
# DB_INSTANCE=SQLEXPRESS

# Puerto del servidor Express
PORT=3000
