{
  "info": {
    "name": "Productos API - Programación Web II",
    "_postman_id": "7f3a1b2c-5d9e-4a8f-9c12-3e4f5a6b7c8d",
    "description": "Colección para probar el CRUD completo de Productos. Incluye casos 400 y 404.\nBase: http://localhost:3000/api/productos\nFlujo: Petición HTTP → Express → Route → Controller → Model → Sequelize → SQL Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Listar todos",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "Lista todos los productos. Sin registros → 200 []"
      }
    },
    {
      "name": "POST - Crear válido",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Laptop Toshiba\",\n  \"descripcion\": \"i5 16GB RAM\",\n  \"precio\": 4500,\n  \"stock\": 10,\n  \"estado\": true\n}" },
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "Éxito → 201 con producto creado + id real de BD"
      }
    },
    {
      "name": "GET - Obtener por ID (existe)",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/api/productos/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "1"] },
        "description": "Existe → 200 con producto"
      }
    },
    {
      "name": "GET - Obtener por ID (no existe) → 404",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/api/productos/9999", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "9999"] },
        "description": "No existe → 404 { mensaje: Producto no encontrado }"
      }
    },
    {
      "name": "PUT - Actualizar válido",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Laptop Toshiba Actualizada\",\n  \"descripcion\": \"i7 32GB RAM\",\n  \"precio\": 5200,\n  \"stock\": 5,\n  \"estado\": true\n}" },
        "url": { "raw": "http://localhost:3000/api/productos/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "1"] },
        "description": "Éxito → 200 con producto actualizado"
      }
    },
    {
      "name": "PUT - Actualizar no existe → 404",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"No existe\",\n  \"precio\": 100,\n  \"stock\": 1\n}" },
        "url": { "raw": "http://localhost:3000/api/productos/9999", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "9999"] },
        "description": "No existe → 404"
      }
    },
    {
      "name": "GET - Buscar?nombre=Laptop (con coincidencias)",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/api/productos/buscar?nombre=Laptop", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "buscar"], "query": [{ "key": "nombre", "value": "Laptop" }] },
        "description": "Búsqueda parcial LIKE → 200 con array (puede ser [])"
      }
    },
    {
      "name": "GET - Buscar?nombre=XYZ (sin coincidencias) → 200 []",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/api/productos/buscar?nombre=XYZ_NO_EXISTE", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "buscar"], "query": [{ "key": "nombre", "value": "XYZ_NO_EXISTE" }] },
        "description": "Sin coincidencias → 200 [] nunca 404"
      }
    },
    {
      "name": "DELETE - Eliminar existe",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:3000/api/productos/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "1"] },
        "description": "Éxito → 200 { mensaje: Producto eliminado correctamente }"
      }
    },
    {
      "name": "DELETE - Eliminar no existe → 404",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:3000/api/productos/9999", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos", "9999"] },
        "description": "No existe → 404"
      }
    },
    {
      "name": "400 - POST sin nombre",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"precio\": 100,\n  \"stock\": 5\n}" },
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "Falta nombre → 400 Bad Request"
      }
    },
    {
      "name": "400 - POST precio <=0",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto malo\",\n  \"precio\": 0,\n  \"stock\": 5\n}" },
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "precio 0 → 400"
      }
    },
    {
      "name": "400 - POST stock negativo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto malo\",\n  \"precio\": 100,\n  \"stock\": -1\n}" },
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "stock -1 → 400"
      }
    },
    {
      "name": "400 - POST precio negativo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto malo\",\n  \"precio\": -50,\n  \"stock\": 5\n}" },
        "url": { "raw": "http://localhost:3000/api/productos", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "productos"] },
        "description": "precio negativo → 400"
      }
    }
  ]
}
